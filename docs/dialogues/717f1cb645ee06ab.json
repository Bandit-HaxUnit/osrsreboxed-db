  "steps": [
    {
      "player": "Hello."
    },
    {
      "type": "message",
      "text": "The dwarf lady seems to be looking for someone.",
      "id": "2LpZZJ"
    },
    {
      "npc": "Hello, I'm looking for my husband. Have you seen him?"
    },
    {
      "player": "What does he look like?"
    },
    {
      "npc": "Oh, to pot with this silly charade, I'm down here to try and win big on the moggies."
    },
    {
      "player": "Hang on, I thought you were looking for your husband."
    },
    {
      "npc": "Um no, I was just pretending. It's frowned on a little to be seen in these parts."
    },
    {
      "player": "So how do these rat pits work?"
    },
    {
      "npc": "The Keldagrim pits cater for those with the larger variety of cats."
    },
    {
      "npc": "If you have an overgrown cat and a couple of coins you can challenge someone else who also has an overgrown cat and some spare change."
    },
    {
      "player": "That sounds simple enough so far."
    },
    {
      "npc": "You then agree on a wager. It's rumoured that some ratcatchers can talk to their own cats and give them tactics to aid them."
    },
    {
      "player": "So then how do you win the challenge?"
    },
    {
      "npc": "I was just getting to that. Both the challengers' cats are placed inside the arena, and whichever kills 9 rats first wins."
