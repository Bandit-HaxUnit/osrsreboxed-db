    "before-the-fremennik-trials-with-a-spined-dagannoth-hide": [
      {
        "type": "choice",
        "prompt": "What would you like to ask about?",
        "options": [
          {
            "text": "Dagannoth Spined Armour",
            "steps": [
              {
                "player": "Hello there. I have some spined dagannoth hides, and believe you might be able to make an armour of them for me...?"
              },
              {
                "npc": "My apologies outerlander, but we are forbidden by decree to communicate with those not of our tribe, and this includes making armour for you."
              },
              {
                "npc": "I suggest you speak to Brundt, our chieftain. He resides in the longhall and speaks for us all."
              }
            ]
          },
          {
            "text": "The Fremennik Trials",
            "steps": [
              {
                "type": "call",
                "branch": "xqb-P0"
              }
            ]
          }
        ]
      }
    ],
    "after-the-fremennik-trials": [
      {
        "player": "Hello again Sigli."
      },
      {
        "npc": "Hello again to you [Fremennik name]. How goes the hunt?"
      },
      {
        "player": "The hunt? I've already done your task! That's why I'm a Fremennik now!"
      },
      {
        "npc": "You think so do you? The Draugen is always out there, just as I and my hunters are always on its trail to keep it at bay."
      },
      {
        "npc": "The hunt will never end until I do."
      }
    ],
