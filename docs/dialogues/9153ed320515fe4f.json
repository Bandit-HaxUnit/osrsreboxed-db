          {
            "text": "Dialogue 1",
            "steps": [
              {
                "player": "What's it like being conjoined?"
              },
              {
                "npc": "I forget they're there most the time."
              },
              {
                "type": "line",
                "speaker": "Chewy",
                "text": "Until I need some fur to throw."
              },
              {
                "type": "line",
                "speaker": "Nibbles",
                "text": "Or I have to cast a bolt of electricity."
              },
              {
                "player": "You could say they're a pain in your backside."
              },
              {
                "npc": "They'll be a pain in your backside soon if we don't get fed."
              }
            ]
          },
          {
            "text": "Dialogue 2",
            "steps": [
              {
                "player": "What do you like to eat?"
              },
              {
                "type": "line",
                "speaker": "Nibbles",
                "text": "Humans."
              },
              {
                "player": "Humans?"
              },
              {
                "npc": "Nibbles said cheese. We like to eat cheese."
              },
              {
                "player": "Phew, that was close."
              },
              {
                "type": "line",
                "speaker": "Nibbles",
                "text": "Humans topped with cheese."
              },
              {
                "player": "What?"
              },
              {
                "npc": "We like cheese. Just cheese."
              },
              {
                "player": "I'm going to keep an eye on you. You've got a bad rattitude."
              },
              {
                "type": "line",
                "speaker": "Chewy",
                "text": "Got any cheese?"
              },
              {
                "player": "Maybe I'll give you some cheese if you're a good rat and don't eat me."
              },
              {
                "npc": "Cheese."
              },
              {
                "player": "Cheese?"
              },
              {
                "type": "line",
                "speaker": "Nibbles",
                "text": "That means deal in rat speak."
              },
              {
                "player": "Thanks Nibbles. Cheese!"
              }
            ]
          },
          {
