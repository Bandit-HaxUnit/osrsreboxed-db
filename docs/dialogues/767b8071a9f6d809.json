    "standard-dialogue-with-catspeak-overgrown-hellcat-talk-to": [
      {
        "type": "choice",
        "options": [
          {
            "text": "How are you doing?",
            "steps": [
              {
                "player": "How are you doing?"
              },
              {
                "npc": "Frankly, I could do with it being a bit hotter round here, but I'll survive."
              },
              {
                "player": "Why's that then?"
              },
              {
                "npc": "Those of us more in touch with our past tend to like it warmer. It's the legacy of the Felis Silvestris Lybica, or desert cat as you would say."
              },
              {
                "player": "Cats? In the desert?"
              },
              {
                "npc": "Oh yes. Many of us left due to the harsh conditions. Sand is the worst thing to lick yourself clean from."
              },
              {
                "player": "I'll bet!"
              },
              {
                "type": "jump",
                "reference": "initial",
                "id": "VvovzV"
              }
            ]
          },
          {
            "text": "How old are you now?",
            "steps": [
              {
                "player": "How old are you now?"
              },
              {
                "npc": "Age is irrelevant. Time is irrelevant."
              },
              {
                "player": "Erm, no, I mean, how are you doing?"
              },
              {
                "npc": "Look into my eyes..."
              },
              {
                "player": "...my belly is full from the crunching of bones you leave behind, and my paws ache."
              },
              {
                "player": "Huh? Who said that?"
              },
              {
                "npc": "I did, via you. Shall I do it again?"
              },
              {
                "type": "jump",
                "reference": "initial",
                "id": "NoRXAG"
              }
            ]
          },
          {
            "text": "Where do you want to go?",
            "steps": [
              {
                "player": "Where do you want to go?"
              },
              {
                "npc": "Straight down the throat of destruction, grasping the tonsil of death as we swing into the belly of evil!"
              },
              {
                "player": "I see. Is that located anywhere near Lumbridge?"
              },
              {
                "npc": "Only in your nightmares, no-fur."
              },
              {
                "player": "I do have a name you know."
              },
              {
                "npc": "And so do I. But you didn't stop to ask before naming me yourself, did you?"
              },
              {
                "player": "Touche my friend, touche."
              },
              {
                "type": "jump",
                "reference": "initial",
                "id": "9pyjI8"
              }
            ]
          },
          {
            "text": "What do you want to do now?",
            "steps": [
              {
                "player": "What do you want to do now?"
              },
              {
                "npc": "I'd love to crunch up some rats. Mmm... rats."
              },
              {
                "player": "Hey, why do rats need oiling?"
              },
              {
                "npc": "Oiling? I have no idea."
              },
              {
                "player": "Because they squeak. Get it? They squeak!"
              },
              {
                "npc": "Wow. That's so funny I almost laughed. I guess I'll have to eat something else then."
              },
              {
                "player": "I don't like the way you're looking at me. We'll go get some rats soon, I promise."
              },
              {
                "npc": "Good answer, no-fur."
              },
              {
                "type": "jump",
                "reference": "initial",
                "id": "enu8Cc"
              }
            ]
          }
        ]
      }
    ],
