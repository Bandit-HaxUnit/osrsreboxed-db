    "jump-eefca008d6f91a9e": [
      {
        "player": "Kahlith?"
      },
      {
        "npc": "Yes. At one time we were like you, but then we met the Tasakaal. They taught us to have purpose. They taught us to serve the balance."
      },
      {
        "npc": "Our old lives were left behind. In their place, the Kahlith were born."
      },
      {
        "type": "choice",
        "options": [
          {
            "text": "Tasakaal?",
            "steps": [
              {
                "player": "Tasakaal?"
              },
              {
                "npc": "Our teachers. They showed us the way and taught us to serve the balance."
              },
              {
                "type": "jump",
                "reference": "other",
                "id": "cu4Z5K"
              }
            ]
          },
          {
            "text": "The balance?",
            "steps": [
              {
                "player": "The balance?"
              },
              {
                "npc": "For every death, there must be life. For every life, there must be a death. This is the balance."
              },
              {
                "npc": "Our purpose, as taught to us by the Tasakaal, is to keep this balance, no matter the cost."
              },
              {
                "type": "jump",
                "reference": "other",
                "id": "5kYv7L"
              }
            ]
          },
          {
            "text": "What is this place?",
            "steps": [
              {
                "type": "jump",
                "id": "Lx-jh2",
                "steps": [
                  {
                    "type": "call",
                    "branch": "jump-eba12380162765fd"
                  }
                ]
              }
            ]
          },
          {
            "text": "That's all thanks.",
            "steps": [
              {
                "type": "jump",
                "id": "uiBAt_",
                "steps": [
                  {
                    "type": "call",
                    "branch": "jump-aa6a2968de0e7e6b"
                  }
                ]
              }
            ]
          }
        ]
      }
