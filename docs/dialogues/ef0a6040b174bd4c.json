    "standard-dialogue": [
      {
        "player": "Hello!"
      },
      {
        "npc": "Greetings! I'm Cassim. Welcome to my home."
      },
      {
        "type": "choice",
        "options": [
          {
            "text": "That's a big barrel of wine!",
            "steps": [
              {
                "player": "That's a big barrel of wine!"
              },
              {
                "npc": "Isn't it just! I'm a bit of a connoisseur."
              },
              {
                "player": "Do you make it yourself?"
              },
              {
                "npc": "I've dabbled, but this is all imported. I have a connection in the far west who has the best vineyards."
              },
              {
                "player": "In the west?"
              },
              {
                "npc": "Yes! A fine Hosidius grape, strong hints of plum and blackberry, very sweet."
              },
              {
                "player": "Sounds lovely!"
              }
            ]
          },
          {
            "text": "How's the tea here?",
            "condition": "After talking to Ali the Tea Seller:",
            "steps": [
              {
                "player": "How's the tea here?"
              },
              {
                "npc": "It's fantastic! Ali really knows how to brew a fine tea!"
              },
              {
                "player": "Which is your favourite?"
              },
              {
                "npc": "Well I've supplied him with a small import of mine. I call the concoction 'Zamorak's Fire'."
              },
              {
                "player": "Sounds hot!"
              },
              {
                "npc": "Yes, yes. It has a certain kick to it! Although, it'll keep you safe from fire for a short time after drinking!"
              },
              {
                "npc": "Great for when dragons attack!"
              },
              {
                "player": "Does that happen often here?"
              },
              {
                "npc": "You never know... Dragons can be sneaky."
              }
            ],
            "id": "eTLECv"
          },
          {
            "text": "I'd best be off.",
            "steps": [
              {
                "player": "I'd best be off."
              },
              {
                "npc": "May the flames of Zamorak light your path."
              },
              {
                "player": "Er... yeah..."
              }
            ]
          }
        ]
      }
